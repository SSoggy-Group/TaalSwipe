{
  "expo": {
    "name": "TaalSwipe",
    "slug": "taalswipe",
    "description": "Swipe through Dutch language challenges, build streaks, and improve spelling, grammar, slang, and brand-name knowledge.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "taalswipe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ssoggygroup.taalswipe",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ssoggygroup.taalswipe",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1F4E79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withAbiSplits"
    ],
    "owner": "ssoggy-group",
    "extra": {
      "eas": {
        "projectId": "d4eea8f0-a0b9-4cf8-aded-70486af8942f"
      }
    }
  }
}
