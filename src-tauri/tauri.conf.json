{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TaalSwipe",
  "version": "1.0.0",
  "identifier": "com.maaren.taalswipe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "node node_modules/expo/bin/cli start --web --port 8081",
    "beforeBuildCommand": "node scripts/prepare-tauri-web.js"
  },
  "app": {
    "windows": [
      {
        "title": "TaalSwipe",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
